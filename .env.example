# DenKit Stash Environment Configuration

# Domain Configuration
DOMAIN=example.com
DENKIT_SUBDOMAIN=stash.denkit
DENKIT_API_SUBDOMAIN=api.denkit
DENKIT_STORAGE_SUBDOMAIN=storage.denkit

# Database Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=denkit
POSTGRES_USER=denkit
POSTGRES_PASSWORD=your_secure_password_here

# S3-Compatible Storage Configuration
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=https://storage.denkit.example.com
S3_ACCESS_KEY=admin
S3_SECRET_KEY=your_rustfs_root_password
S3_BUCKET=denkit-storage
S3_USE_SSL=false

# RustFS Root Credentials
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=your_rustfs_root_password

# Application Configuration
PORT=8080
GIN_MODE=release
LOG_LEVEL=info
# Development-only credential/test routes stay disabled in production.
ENABLE_DEV_ENDPOINTS=false
# Required secret used to store non-reversible HMAC digests of DenKit API keys.
# Generate a unique value for each deployment, for example:
#   openssl rand -hex 32
DENKIT_API_KEY_HASH_SECRET=replace_with_64_random_hex_chars
# HTTP server timeout defaults. Use Go duration syntax.
DENKIT_HTTP_READ_HEADER_TIMEOUT=5s
DENKIT_HTTP_READ_TIMEOUT=30m
DENKIT_HTTP_WRITE_TIMEOUT=30m
DENKIT_HTTP_IDLE_TIMEOUT=2m
# Request-size controls. Defaults are 1 MiB for metadata requests and 50 GiB
# per deferred upload session.
DENKIT_MAX_REQUEST_BODY_BYTES=1048576
DENKIT_MAX_UPLOAD_SESSION_BYTES=53687091200

# Traefik Configuration
TRAEFIK_NETWORK=web

# Database Volumes
DB_VOLUME_NAME=denkit_postgres_data
RUSTFS_VOLUME_NAME=denkit_rustfs_data
